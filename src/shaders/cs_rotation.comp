#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#include "descriptor_set.h"

layout(
    local_size_x = 8,
    local_size_y = 8,
    local_size_z = 1) in;

#include "blit_push_data.h"
#include "composite.h"

vec4 sampleLayer(uint layerIdx, vec2 uv) {
    if ((c_ycbcrMask & (1 << layerIdx)) != 0)
        return sampleLayer(s_ycbcr_samplers[layerIdx], layerIdx, uv, false);
    return sampleLayer(s_samplers[layerIdx], layerIdx, uv, true);
}

void main() {
    // coord is output pixel position (based on physical screen dimensions)
    uvec2 outCoord = uvec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y);
    uvec2 outSize = imageSize(dst);
    
    // Calculate input sampling coordinates (based on logical/game dimensions)
    // Input textures are in logical orientation, output is in physical orientation
    // Enum values: 0=PANEL_ORIENTATION_0, 1=PANEL_ORIENTATION_270, 2=PANEL_ORIENTATION_90, 3=PANEL_ORIENTATION_180
    vec2 sampleCoord;
    
    switch (u_rotation) {
        case 0u: // GAMESCOPE_PANEL_ORIENTATION_0 - 0° - no rotation
            sampleCoord = vec2(outCoord.x, outCoord.y);
            break;
            
        case 1u: // GAMESCOPE_PANEL_ORIENTATION_270 - 270° CCW
            // Physical pixel (x, y) comes from logical pixel (y, height-1-x)
            sampleCoord = vec2(outCoord.y, outSize.x - outCoord.x - 1);
            break;
            
        case 2u: // GAMESCOPE_PANEL_ORIENTATION_90 - 90° CCW
            // Physical pixel (x, y) comes from logical pixel (width-1-y, x)
            sampleCoord = vec2(outSize.y - outCoord.y - 1, outCoord.x);
            break;
            
        case 3u: // GAMESCOPE_PANEL_ORIENTATION_180 - 180°
            sampleCoord = vec2(outSize.x - outCoord.x - 1, outSize.y - outCoord.y - 1);
            break;
            
        default:
            sampleCoord = vec2(outCoord.x, outCoord.y);
            break;
    }
    
    vec4 outputValue = vec4(255.0f);

    if (c_layerCount > 0) {
        outputValue = sampleLayer(0, sampleCoord) * u_opacity[0];
    }

    for (int i = 1; i < c_layerCount; i++) {
        vec4 layerColor = sampleLayer(i, sampleCoord);
        // wl_surfaces come with premultiplied alpha, so that's them being
        // premultiplied by layerColor.a.
        // We need to then multiply that by the layer's opacity to get to our
        // final premultiplied state.
        // For the other side of things, we need to multiply by (1.0f - (layerColor.a * opacity))
        float opacity = u_opacity[i];
        float layerAlpha = opacity * layerColor.a;
        outputValue = layerColor * opacity + outputValue * (1.0f - layerAlpha);
    }

    outputValue.rgb = encodeOutputColor(outputValue.rgb);

    imageStore(dst, ivec2(outCoord), outputValue);
}
